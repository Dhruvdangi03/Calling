<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Calling" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/blush_primary</item>
        <item name="colorPrimaryVariant">@color/blush_primary_dark</item>
        <item name="colorOnPrimary">@color/warm_on_primary</item>
        <item name="colorSecondary">@color/plum_accent</item>
        <item name="colorSecondaryVariant">@color/plum_accent</item>
        <item name="colorOnSecondary">@color/warm_on_primary</item>
        <item name="android:colorBackground">@color/warm_background</item>
        <item name="colorSurface">@color/warm_surface</item>
        <item name="colorOnBackground">@color/warm_on_background</item>
        <item name="colorOnSurface">@color/warm_on_background</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/warm_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>

    <style name="Theme.Calling.FullScreenCall" parent="Theme.Calling">
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- The small circular control buttons (mute/camera/switch-camera/speaker/end) on InCallActivity. -->
    <style name="CallControlButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="backgroundTint">@color/blush_primary_dark</item>
        <item name="cornerRadius">28dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">24dp</item>
        <item name="iconTint">@color/warm_on_primary</item>
    </style>
</resources>
