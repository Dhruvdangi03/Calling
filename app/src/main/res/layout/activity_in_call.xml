<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/plum_accent"
    tools:context=".ui.call.InCallActivity">

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/rendererRemote"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutAudioOnly"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.32">

        <ImageView
            android:id="@+id/imagePartnerPhotoAudio"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:background="@drawable/bg_partner_photo_placeholder"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/textPartnerNameAudio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/warm_on_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Partner name" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLocalPreview"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/rendererLocal"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/textConnectionStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_partner_photo_placeholder"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="Connecting..."
        android:textColor="@color/warm_on_primary"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonMute"
            style="@style/CallControlButton"
            android:layout_marginEnd="14dp"
            app:icon="@drawable/ic_mic" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCamera"
            style="@style/CallControlButton"
            android:layout_marginEnd="14dp"
            android:visibility="gone"
            app:icon="@drawable/ic_videocam" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSwitchCamera"
            style="@style/CallControlButton"
            android:layout_marginEnd="14dp"
            android:visibility="gone"
            app:icon="@drawable/ic_camera_switch" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSpeaker"
            style="@style/CallControlButton"
            android:layout_marginEnd="14dp"
            app:icon="@drawable/ic_volume_off" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonEndCall"
            style="@style/CallControlButton"
            android:backgroundTint="@color/status_error"
            app:icon="@drawable/ic_call_end" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
